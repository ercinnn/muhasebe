app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# dart-define-from-file secrets (Supabase URL/anon key, Firebase config)
/env/*.json
!/env/dev.example.json

# Firebase generated config (contains project-specific IDs; regenerate via flutterfire configure)
lib/firebase_options.dart

# Claude Code harness runtime state
.claude/scheduled_tasks.lock
